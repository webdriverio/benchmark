{
  "name": "@wdio/benchmark",
  "private": true,
  "type": "module",
  "description": "Browser agent benchmark: browser tools for AI agents on live-web tasks from Online-Mind2Web, with the same model, harness and prompt for every tool",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "node src/run.ts",
    "report": "node src/report.ts",
    "check:types": "tsc --noEmit",
    "plan": "node src/plan.ts",
    "publish": "node src/publish.ts",
    "site": "node src/site.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
